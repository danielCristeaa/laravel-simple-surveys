{
    "name": "danielcristea/laravel-simple-surveys",
    "description": "A lightweight, code-first Laravel package for running targeted in-app surveys with a drop-in Blade widget and protected results dashboard.",
    "keywords": [
        "laravel",
        "surveys",
        "feedback",
        "blade",
        "eloquent"
    ],
    "homepage": "https://github.com/danielcristea/laravel-simple-surveys",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Cristea",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "DanielCristea\\SimpleSurveys\\": "src/",
            "DanielCristea\\SimpleSurveys\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DanielCristea\\SimpleSurveys\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "format:check": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DanielCristea\\SimpleSurveys\\SimpleSurveysServiceProvider"
            ],
            "aliases": {
                "SimpleSurveys": "DanielCristea\\SimpleSurveys\\Facades\\SimpleSurveys"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
